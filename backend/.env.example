# =============================================================================
# SmartReco Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=SmartReco
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://smartreco:smartreco_password@localhost:5432/smartreco_db

# Database pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis connection string
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# ChromaDB Configuration
# =============================================================================
# ChromaDB host and port
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=smartreco_embeddings

# =============================================================================
# Embedding Model Configuration
# =============================================================================
# Sentence Transformers model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# Mesh API Configuration (OpenAI-compatible LLM Gateway)
# =============================================================================
# Mesh API credentials
MESH_API_KEY=your_mesh_api_key_here
MESH_API_BASE_URL=https://api.mesh.com/v1
MESH_MODEL=gpt-4-turbo-preview
MESH_MAX_TOKENS=4096
MESH_TEMPERATURE=0.7

# =============================================================================
# LangSmith Configuration (Observability)
# =============================================================================
# LangSmith API key and project
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=smartreco-prod
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_ENABLED=True

# =============================================================================
# Authentication & Security
# =============================================================================
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# =============================================================================
# SMTP Configuration (Email)
# =============================================================================
# Email server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@smartreco.com
SMTP_FROM_NAME=SmartReco Platform
SMTP_TLS=True
SMTP_SSL=False

# =============================================================================
# Recommendation System Settings
# =============================================================================
# Recommendation parameters
DEFAULT_RECOMMENDATION_COUNT=10
MAX_RECOMMENDATION_COUNT=50
MIN_SIMILARITY_THRESHOLD=0.6
DIVERSITY_FACTOR=0.3

# Cache settings
RECOMMENDATION_CACHE_TTL=3600
PERSONA_CACHE_TTL=1800

# =============================================================================
# Scheduler Configuration
# =============================================================================
# APScheduler settings
SCHEDULER_ENABLED=True
SCHEDULER_TIMEZONE=UTC

# Background job intervals (in minutes)
PERSONA_UPDATE_INTERVAL=60
EMBEDDING_REFRESH_INTERVAL=1440
ANALYTICS_JOB_INTERVAL=30

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/smartreco.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# Celery Configuration (Optional - for async tasks)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_BEHAVIORAL_ANALYSIS=True
ENABLE_PERSONA_GENERATION=True
ENABLE_NARRATIVE_GENERATION=True
ENABLE_DIVERSITY_BOOST=True
ENABLE_COLD_START_HANDLING=True

# =============================================================================
# Monitoring & Metrics
# =============================================================================
ENABLE_METRICS=True
METRICS_PORT=9090
HEALTH_CHECK_ENDPOINT=/health
